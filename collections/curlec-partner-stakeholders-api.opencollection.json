{
  "opencollection": "1.0.0",
  "info": {
    "name": "Razorpay Bills Partner Stakeholders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Partner Stakeholders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch all stakeholders for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/stakeholders",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the linked merchant account (e.g. `acc_00000000000001`)."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve all stakeholders associated with a sub-merchant account. Partners API only — Route allows only 1 stakeholder per account. Authentication: OAuth access_token."
        },
        {
          "info": {
            "name": "Create a Stakeholder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/stakeholders",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the linked merchant account (e.g. `acc_00000000000001`)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a business owner or director to a Linked Account. Only one stakeholder is allowed per Route Linked Account. PAN 4th character must be 'P' (individual PAN)."
        },
        {
          "info": {
            "name": "Update a Stakeholder",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/stakeholders/:stakeholder_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Linked Account ID (acc_*)."
              },
              {
                "name": "stakeholder_id",
                "value": "",
                "type": "path",
                "description": "Stakeholder ID (sth_*)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update stakeholder information for a Linked Account."
        }
      ]
    }
  ],
  "bundled": true
}