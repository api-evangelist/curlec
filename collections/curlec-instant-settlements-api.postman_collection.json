      "id": "c634e4c6-8004-42c2-b8ce-673f33acd63e",
      "name": "Instant Settlements",
      "description": {
        "content": "On-demand settlements let you transfer your available Razorpay balance to your bank account immediately, outside the normal settlement cycle. Fees apply. Requires Instant Settlements to be enabled on your account.",
        "type": "text/plain"
      },
