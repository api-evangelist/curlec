      "name": "X Transactions",
      "description": {
        "content": "Fetch RazorpayX transaction records — credits (bank_transfer inflows) and debits (payout outflows)",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7ed45a58-ac95-4f46-8dce-feccc20c8bb7",
          "name": "List transactions for a RazorpayX account",
          "request": {
            "name": "List transactions for a RazorpayX account",
            "description": {
              "content": "Returns all transaction records (credits and debits) for a given RazorpayX account. Use account_number from Dashboard → My Account & Settings → Banking → Customer Identifier.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "account_number",
                  "value": "<string>",
                  "description": "(Required) RazorpayX account number (Customer Identifier from Dashboard). Different for Test and Live mode."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<integer>",
                  "description": "Unix timestamp filter start"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<integer>",
                  "description": "Unix timestamp filter end"
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "10",
                  "description": "Number of transactions to return. Default: 10. Maximum: 100."
                },
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "0",
                  "description": "Number of transactions to skip. Use for pagination. Default: 0."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
