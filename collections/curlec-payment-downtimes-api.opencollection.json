{
  "opencollection": "1.0.0",
  "info": {
    "name": "Razorpay Bills Payment Downtimes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payment Downtimes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch all payment downtimes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/payments/downtimes"
          },
          "docs": "Retrieve current and upcoming payment method downtimes for cards, netbanking, and UPI. Use to surface degraded methods in checkout UI."
        },
        {
          "info": {
            "name": "Fetch payment downtime by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/payments/downtimes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Downtime identifier."
              }
            ]
          },
          "docs": "Retrieve details of a specific payment downtime event."
        }
      ]
    }
  ],
  "bundled": true
}