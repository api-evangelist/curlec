{
  "opencollection": "1.0.0",
  "info": {
    "name": "Razorpay Bills Plans API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Plans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all plans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/plans",
            "params": [
              {
                "name": "count",
                "value": "",
                "type": "query",
                "description": "Number of records to return per call. Maximum 100. Default 10."
              },
              {
                "name": "skip",
                "value": "",
                "type": "query",
                "description": "Number of records to skip. Use with count for pagination. Default 0."
              }
            ]
          },
          "docs": "Retrieve all billing plans. Supports pagination."
        },
        {
          "info": {
            "name": "Create a plan",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/plans",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Define a recurring billing plan with a fixed period, interval, and amount. Plans are reusable across multiple subscriptions. Once created, plan details cannot be modified."
        },
        {
          "info": {
            "name": "Fetch a plan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/plans/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Plan ID (plan_*)."
              }
            ]
          },
          "docs": "Get details of a specific billing plan."
        }
      ]
    }
  ],
  "bundled": true
}