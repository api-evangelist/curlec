{
  "opencollection": "1.0.0",
  "info": {
    "name": "Razorpay Bills API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bills",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a bill",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/bills",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Create a digital bill/receipt for a customer. Supports retail, food & beverage, events, and ecommerce use cases. Used for Razorpay Billme digital receipts."
        },
        {
          "info": {
            "name": "Update a bill",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.razorpay.com/v1/bills/:bill_id",
            "params": [
              {
                "name": "bill_id",
                "value": "",
                "type": "path",
                "description": "Bill ID with prefix bill_"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Update an existing digital bill. Can update customer details, line items, receipt summary, and other fields."
        },
        {
          "info": {
            "name": "Delete a bill",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.razorpay.com/v1/bills/:bill_id",
            "params": [
              {
                "name": "bill_id",
                "value": "",
                "type": "path",
                "description": "Bill ID with prefix bill_"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Delete a digital bill/receipt."
        }
      ]
    }
  ],
  "bundled": true
}