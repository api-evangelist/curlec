{
  "opencollection": "1.0.0",
  "info": {
    "name": "Razorpay Bills Linked Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Linked Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a Linked Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/v2/accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a sub-merchant (Linked Account) under a Route marketplace. The account type must be 'route'. Email and business_type cannot be changed after creation. Only one stakeholder is allowed per Linked Account."
        },
        {
          "info": {
            "name": "Fetch a Linked Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Linked Account ID (acc_*)."
              }
            ]
          },
          "docs": "Retrieve the details of a Linked Account by its ID. Also used in Partners API to fetch sub-merchant account details (authentication: OAuth access_token)."
        },
        {
          "info": {
            "name": "Update a Linked Account",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Linked Account ID (acc_*)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update mutable fields of a Linked Account. email and business_type cannot be changed after creation."
        },
        {
          "info": {
            "name": "Create a Stakeholder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/stakeholders",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the linked merchant account (e.g. `acc_00000000000001`)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a business owner or director to a Linked Account. Only one stakeholder is allowed per Route Linked Account. PAN 4th character must be 'P' (individual PAN)."
        },
        {
          "info": {
            "name": "Update a Stakeholder",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/stakeholders/:stakeholder_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Linked Account ID (acc_*)."
              },
              {
                "name": "stakeholder_id",
                "value": "",
                "type": "path",
                "description": "Stakeholder ID (sth_*)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update stakeholder information for a Linked Account."
        },
        {
          "info": {
            "name": "Request Route product configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/products",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Linked Account ID (acc_*)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Request activation of the Route product for a Linked Account. Submits the account for review and KYC. Activation progresses: requested → under_review → activated."
        },
        {
          "info": {
            "name": "Fetch product configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/products/:product_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Linked Account ID (acc_*)."
              },
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Product configuration ID (acc_prd_*)."
              }
            ]
          },
          "docs": "Retrieve the current product configuration and activation status for a Linked Account."
        },
        {
          "info": {
            "name": "Update product configuration",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.razorpay.com/v1/v2/accounts/:account_id/products/:product_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Linked Account ID (acc_*)."
              },
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "Product configuration ID (acc_prd_*)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update settlement details or other configuration for a Route product on a Linked Account."
        }
      ]
    }
  ],
  "bundled": true
}