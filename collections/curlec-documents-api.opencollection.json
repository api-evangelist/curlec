{
  "opencollection": "1.0.0",
  "info": {
    "name": "Razorpay Bills Documents API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload a document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/documents",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "purpose",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload a file to Razorpay. Returns a document ID that can be used in dispute evidence submissions. Supports JPEG, PNG, and PDF formats."
        },
        {
          "info": {
            "name": "Fetch document info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.razorpay.com/v1/documents/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Document ID (doc_*). Exactly 14 alphanumeric characters."
              }
            ]
          },
          "docs": "Retrieve metadata for an uploaded document (name, MIME type, size, purpose). Document IDs are exactly 14 alphanumeric characters."
        },
        {
          "info": {
            "name": "Fetch document content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.razorpay.com/v1/documents/:id/content",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Document ID. Exactly 14 alphanumeric characters."
              }
            ]
          },
          "docs": "Retrieve the binary content of a previously uploaded document. Returns the raw file bytes."
        }
      ]
    }
  ],
  "bundled": true
}